---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | xml_escape }}</subtitle>
  <id>{{ site.url }}{{ site.baseurl }}/feed.xml</id>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
  {% assign catalogue = site.recordings | concat: site.mixtapes | sort: "name" | reverse %}
  {% for item in catalogue %}
  <entry>
    <title>{{ item.title | xml_escape }}</title>
    <id>{{ site.url }}{{ site.baseurl }}{{ item.url }}</id>
    <link href="{{ site.url }}{{ site.baseurl }}{{ item.url }}" rel="alternate" type="text/html" />
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    {% if item.summary %}<summary>{{ item.summary | strip_newlines | xml_escape }}</summary>{% elsif item.description %}<summary>{{ item.description | strip_newlines | xml_escape }}</summary>{% endif %}
    <content type="html"><![CDATA[{{ item.content | markdownify }}]]></content>
  </entry>
  {% endfor %}
</feed>
